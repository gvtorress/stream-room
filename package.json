{
  "name": "selfhosted-discord",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "main": "index.js",
  "scripts": {
    "api:start": "pnpm --filter api run start",
    "api:start:dev": "pnpm --filter api run start:dev",
    "api:start:prod": "pnpm --filter api run start:prod",
    "api:start:debug": "pnpm --filter api run start:debug",
    "api:build": "pnpm --filter api run build",
    "api:format": "pnpm --filter api run format",
    "api:format:check": "pnpm --filter api run format:check",
    "api:lint": "pnpm --filter api run lint",
    "api:typecheck": "pnpm --filter api run typecheck",
    "api:test": "pnpm --filter api run test",
    "api:test:watch": "pnpm --filter api run test:watch",
    "api:test:cov": "pnpm --filter api run test:cov",
    "api:test:e2e": "pnpm --filter api run test:e2e",
    "api:check": "pnpm api:lint && pnpm api:typecheck && pnpm api:test && pnpm api:build",
    "web:start": "pnpm --filter frontend run start",
    "web:start:dev": "pnpm --filter frontend run start:dev",
    "web:start:prod": "pnpm --filter frontend run start:prod",
    "web:dev": "pnpm --filter frontend run dev",
    "web:build": "pnpm --filter frontend run build",
    "web:format": "pnpm --filter frontend run format",
    "web:format:check": "pnpm --filter frontend run format:check",
    "web:lint": "pnpm --filter frontend run lint",
    "web:typecheck": "pnpm --filter frontend run typecheck",
    "web:preview": "pnpm --filter frontend run preview",
    "web:test": "pnpm --filter frontend run test",
    "web:test:watch": "pnpm --filter frontend run test:watch",
    "web:check": "pnpm web:lint && pnpm web:typecheck && pnpm web:test && pnpm web:build",
    "build": "pnpm -r run build",
    "format": "prettier --write package.json pnpm-workspace.yaml commitlint.config.js README.md && pnpm -r --if-present run format",
    "format:check": "prettier --check package.json pnpm-workspace.yaml commitlint.config.js README.md && pnpm -r --if-present run format:check",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:cov": "pnpm -r --if-present run test:cov",
    "test:e2e": "pnpm -r --if-present run test:e2e",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "commitlint": "commitlint",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.15.0",
  "type": "module",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "prettier": "^3.9.10"
  }
}
